@page "{id:int}"
@using src.Models.Enums
@model src.Pages.Watchlist.EditModel

@{
	ViewData["Title"] = "Edit Movie";
}

<h2 class="mb-4">Edit Movie</h2>

<form method="post">

	<div class="mb-3">
		<label asp-for="Input.Title" class="form-label"></label>
		<input asp-for="Input.Title" class="form-control" />
		<span asp-validation-for="Input.Title" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Input.Status" class="form-label"></label>
		<select asp-for="Input.Status"
		        asp-items="Html.GetEnumSelectList<WatchStatus>()"
		        class="form-select">
		</select>
	</div>

	<div class="mb-3">
		<label asp-for="Input.Rating" class="form-label"></label>
		<input asp-for="Input.Rating" class="form-control" />
		<span asp-validation-for="Input.Rating" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary">
		Save Changes
	</button>

	<a asp-page="/Watchlist/Index" class="btn btn-secondary">
		Cancel
	</a>

</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}