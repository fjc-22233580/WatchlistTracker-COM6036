@page
@using src.Models.Enums
@model src.Pages.Watchlist.CreateModel

@{
	ViewData["Title"] = "Add Movie";
}

<h1>Add Movie</h1>

<form method="post">

	<div class="mb-3">
		<label asp-for="Input.Title" class="form-label"></label>
		<input asp-for="Input.Title" class="form-control" />
		<span asp-validation-for="Input.Title"
		      class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Input.Status" class="form-label"></label>
		<select asp-for="Input.Status"
		        asp-items="Html.GetEnumSelectList<WatchStatus>()"
		        class="form-select">
		</select>
	</div>

	<div class="mb-3">
		<label asp-for="Input.Rating" class="form-label"></label>
		<input asp-for="Input.Rating"
		       class="form-control" />
		<span asp-validation-for="Input.Rating"
		      class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary">
		Add to Watchlist
	</button>

</form>

@if (TempData["SuccessMessage"] is string message)
{
	<div class="alert alert-success" role="alert">
		@message
	</div>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}