@page
@using src.Models.Enums
@model src.Pages.Watchlist.IndexModel

@{
	ViewData["Title"] = "My Watchlist";
}

<h2 class="mb-4">Watchlist</h2>



@if (TempData["SuccessMessage"] is string message)
{
	<div class="alert alert-success" role="alert">
		@message
	</div>
}


<form method="get" class="mb-3">
	<div class="row g-2">

		<div class="col-md-6">
			<input asp-for="SearchTerm"
			       class="form-control"
			       placeholder="Search movies..." />
		</div>

		<div class="col-md-3">
			<select asp-for="StatusFilter"
			        asp-items="Html.GetEnumSelectList<WatchStatus>()"
			        class="form-select">

				<option value="">All statuses</option>
			</select>
		</div>

		<div class="col-md-3">
			<div class="d-flex gap-2">
				<button type="submit"
				        class="btn btn-outline-secondary">
					Filter
				</button>

				<a asp-page="/Watchlist/Index"
				   class="btn btn-outline-secondary">
					Clear
				</a>
			</div>
		</div>

	</div>
</form>

<p>
	<a asp-page="/Watchlist/Create" class="btn btn-primary">
		Add Movie
	</a>
</p>

@if (Model.WatchlistItems.Count == 0)
{
    <p>Your watchlist is empty.</p>
}
else
{
	<div class="row g-4">
		@foreach (var item in Model.WatchlistItems)
		{
			<div class="col-12 col-sm-6 col-md-4 col-lg-3">
				<div class="card h-100 shadow-sm">

					@if (!string.IsNullOrWhiteSpace(item.PosterPath))
					{
						<img src="@Model.GetPosterUrl(item.PosterPath)"
						     class="card-img-top"
						     alt="@item.Title poster"
						     style="width: 100%; height: auto;" />
					}

					<div class="card-body d-flex flex-column">

						<h5 class="card-title">
							@item.Title
						</h5>

						<div class="mb-2">
							<span class="badge bg-secondary">
								@item.Status
							</span>
						</div>

						@if (!string.IsNullOrWhiteSpace(item.Overview))
						{
							<p class="card-text">
								@item.Overview
							</p>
						}

						<div class="mt-auto">

							<div class="mb-3">
								<strong>Your rating:</strong>
								@(item.Rating?.ToString() ?? "-") / 10
							</div>

							@if (item.VoteAverage.HasValue)
							{
								<div class="mb-3">
									<strong>TMDB rating:</strong>
									@item.VoteAverage.Value.ToString("0.0") / 10
								</div>
							}

							<div class="d-flex gap-2">
								<a asp-page="/Watchlist/Edit"
								   asp-route-id="@item.Id"
								   class="btn btn-sm btn-outline-primary">
									Edit
								</a>

								<a asp-page="/Watchlist/Delete"
								   asp-route-id="@item.Id"
								   class="btn btn-sm btn-outline-danger">
									Delete
								</a>
							</div>

						</div>
					</div>

				</div>
			</div>
		}
	</div>
}