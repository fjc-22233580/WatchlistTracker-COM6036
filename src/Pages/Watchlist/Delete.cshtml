@page "{id:int}"
@model src.Pages.Watchlist.DeleteModel

@{
	ViewData["Title"] = "Delete Movie";
}

<h1>Delete Movie</h1>

<div class="alert alert-warning" role="alert">
	Are you sure you want to remove this movie from your watchlist?
</div>

<dl class="row">
	<dt class="col-sm-2">
		Title
	</dt>
	<dd class="col-sm-10">
		@Model.WatchlistItem.Title
	</dd>

	<dt class="col-sm-2">
		Status
	</dt>
	<dd class="col-sm-10">
		@Model.WatchlistItem.Status
	</dd>

	<dt class="col-sm-2">
		Rating
	</dt>
	<dd class="col-sm-10">
		@(Model.WatchlistItem.Rating?.ToString() ?? "-")
	</dd>
</dl>

<form method="post">
	<button type="submit" class="btn btn-danger">
		Delete
	</button>

	<a asp-page="/Watchlist/Index" class="btn btn-secondary">
		Cancel
	</a>
</form>