@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (User.Identity?.IsAuthenticated == true)
{
	<h2 class="mb-4">Welcome back, @User.Identity?.Name!</h2>

	

	<div class="row g-3 mb-4">

		<div class="col-md-3">
			<div class="card h-100">
				<div class="card-body">
					<h5 class="card-title">Total Movies</h5>
					<p class="display-6 mb-0">@Model.TotalMovies</p>
				</div>
			</div>
		</div>

		<div class="col-md-3">
			<div class="card h-100">
				<div class="card-body">
					<h5 class="card-title">Watching</h5>
					<p class="display-6 mb-0">@Model.WatchingMovies</p>
				</div>
			</div>
		</div>

		<div class="col-md-3">
			<div class="card h-100">
				<div class="card-body">
					<h5 class="card-title">Watched</h5>
					<p class="display-6 mb-0">@Model.WatchedMovies</p>
				</div>
			</div>
		</div>
		
		<div class="col-md-3">
			<div class="card h-100">
				<div class="card-body">
					<h5 class="card-title">Planned</h5>
					<p class="display-6 mb-0">@Model.PlannedMovies</p>
				</div>
			</div>
		</div>

	</div>

	<div class="d-flex gap-2">
		<a asp-page="/Watchlist/Index"
		   class="btn btn-primary">
			My Watchlist
		</a>

		<a asp-page="/Watchlist/Create"
		   class="btn btn-outline-primary">
			Add Movie
		</a>
	</div>

    @if (Model.CurrentlyWatching.Count > 0)
    {
        <h3 class="mt-5 mb-3">Currently Watching</h3>

        <div class="row g-4">
            @foreach (var item in Model.CurrentlyWatching)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        <div class="row g-0 h-100">

                            @if (!string.IsNullOrWhiteSpace(item.PosterPath))
                            {
                                <div class="col-4">
                                    <img src="@Model.GetPosterUrl(item.PosterPath)"
                                         class="img-fluid rounded-start h-100"
                                         alt="@item.Title poster"
                                         style="object-fit: cover;" />
                                </div>
                            }

                            <div class="@(!string.IsNullOrWhiteSpace(item.PosterPath) ? "col-8" : "col-12")">
                                <div class="card-body d-flex flex-column h-100">

                                    <h5 class="card-title">
                                        @item.Title
                                    </h5>

                                    <div class="mb-2">
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    </div>

                                    <div class="mb-2">
                                        <strong>Your rating:</strong>
                                        @(item.Rating?.ToString() ?? "-") / 10
                                    </div>

                                    @if (item.VoteAverage.HasValue)
                                    {
                                        <div class="mb-3">
                                            <strong>TMDB rating:</strong>
                                            @item.VoteAverage.Value.ToString("0.0") / 10
                                        </div>
                                    }

                                    <div class="mt-auto">
                                        <a asp-page="/Watchlist/Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-returnUrl="/Index"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="mt-5">
            <h3 class="mb-3">Currently Watching</h3>
            <p class="text-muted">
                You are not currently watching any movies.
            </p>
        </div>
    }
}
else
{
	<div class="py-5">
		<div class="row align-items-center g-4">

			<div class="col-lg-7">
				<h1 class="display-5 fw-bold">
					Watchlist Tracker
				</h1>

				<p class="lead text-muted">
					Search for movies, build a personal watchlist,
					track viewing progress, and record your own ratings.
				</p>

				<div class="d-flex gap-2 mt-4">
					<a asp-area="Identity"
					   asp-page="/Account/Register"
					   class="btn btn-primary btn-lg">
						Create Account
					</a>

					<a asp-area="Identity"
					   asp-page="/Account/Login"
					   class="btn btn-outline-secondary btn-lg">
						Log In
					</a>
				</div>
			</div>

			<div class="col-lg-5">
				<div class="card shadow-sm">
					<div class="card-body">
						<h2 class="h5 mb-3">Features</h2>

						<ul class="mb-0">
							<li>Search movies using TMDB</li>
							<li>Build your own private watchlist</li>
							<li>Track planned, watching and watched movies</li>
							<li>Add personal ratings</li>
							<li>View movie posters and metadata</li>
						</ul>
					</div>
				</div>
			</div>

		</div>
	</div>
}

<div class="card mt-4">
	<div class="card-body">
		<h2 class="h6 mb-3">Service Status</h2>

		<div class="d-flex gap-4">
			<span>
				Database:
				@if (Model.SupabaseAvailable)
				{
					<span class="badge bg-success">
						Available
					</span>
				}
				else
				{
					<span class="badge bg-danger">
						Unavailable
					</span>
				}
			</span>

			<span>
				TMDB:
				@if (Model.TmdbAvailable)
				{
					<span class="badge bg-success">
						Available
					</span>
				}
				else
				{
					<span class="badge bg-danger">
						Unavailable
					</span>
				}
			</span>
		</div>
	</div>
</div>
