@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (User.Identity?.IsAuthenticated == true)
{
	<h2 class="mb-4">Welcome back, @User.Identity?.Name!</h2>

	

	<div class="row g-3 mb-4">

		<div class="col-md-3">
			<div class="card h-100">
				<div class="card-body">
					<h5 class="card-title">Total Movies</h5>
					<p class="display-6 mb-0">@Model.TotalMovies</p>
				</div>
			</div>
		</div>

		<div class="col-md-3">
			<div class="card h-100">
				<div class="card-body">
					<h5 class="card-title">Watching</h5>
					<p class="display-6 mb-0">@Model.WatchingMovies</p>
				</div>
			</div>
		</div>

		<div class="col-md-3">
			<div class="card h-100">
				<div class="card-body">
					<h5 class="card-title">Watched</h5>
					<p class="display-6 mb-0">@Model.WatchedMovies</p>
				</div>
			</div>
		</div>
		
		<div class="col-md-3">
			<div class="card h-100">
				<div class="card-body">
					<h5 class="card-title">Planned</h5>
					<p class="display-6 mb-0">@Model.PlannedMovies</p>
				</div>
			</div>
		</div>

	</div>

	<div class="d-flex gap-2">
		<a asp-page="/Watchlist/Index"
		   class="btn btn-primary">
			My Watchlist
		</a>

		<a asp-page="/Watchlist/Create"
		   class="btn btn-outline-primary">
			Add Movie
		</a>
	</div>

    @if (Model.CurrentlyWatching.Count > 0)
    {
        <h3 class="mt-5 mb-3">Currently Watching</h3>

        <div class="row g-4">
            @foreach (var item in Model.CurrentlyWatching)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        <div class="row g-0 h-100">

                            @if (!string.IsNullOrWhiteSpace(item.PosterPath))
                            {
                                <div class="col-4">
                                    <img src="@Model.GetPosterUrl(item.PosterPath)"
                                         class="img-fluid rounded-start h-100"
                                         alt="@item.Title poster"
                                         style="object-fit: cover;" />
                                </div>
                            }

                            <div class="@(!string.IsNullOrWhiteSpace(item.PosterPath) ? "col-8" : "col-12")">
                                <div class="card-body d-flex flex-column h-100">

                                    <h5 class="card-title">
                                        @item.Title
                                    </h5>

                                    <div class="mb-2">
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    </div>

                                    <div class="mb-2">
                                        <strong>Your rating:</strong>
                                        @(item.Rating?.ToString() ?? "-") / 10
                                    </div>

                                    @if (item.VoteAverage.HasValue)
                                    {
                                        <div class="mb-3">
                                            <strong>TMDB rating:</strong>
                                            @item.VoteAverage.Value.ToString("0.0") / 10
                                        </div>
                                    }

                                    <div class="mt-auto">
                                        <a asp-page="/Watchlist/Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-returnUrl="/Index"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="mt-5">
            <h3 class="mb-3">Currently Watching</h3>
            <p class="text-muted">
                You are not currently watching any movies.
            </p>
        </div>
    }
}
else
{
	<h2 class="mb-4">Watchlist Tracker</h2>
	<p>Create and manage your personal movie watchlist.</p>
}
